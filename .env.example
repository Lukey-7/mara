# Copy to .env and fill in. Never commit .env.

# --- LLM ---
LLM_PROVIDER=gemini                 # gemini | openai
GEMINI_API_KEY=                     # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings ---
EMBEDDING_PROVIDER=local            # local (no key, CPU) | gemini | openai
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# API providers only: Matryoshka truncation (Gemini and OpenAI both support it). Changing
# the model or size means re-ingesting into a new collection: the store refuses mismatches.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100

# --- Agents ---
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT_S=120                 # per step; a timed-out step degrades the run, not aborts it
RESEARCH_TOP_K=6                    # chunks per sub-question given to the summarizer
MAX_CRITIC_LOOPS=1
WEB_SEARCH_PROVIDER=none            # none | duckduckgo (free, no key) | tavily
TAVILY_API_KEY=
WEB_SEARCH_RESULTS=3
TRACE_DIR=data/traces               # one JSON per finished run

# --- Retrieval ---
RERANKER=cross-encoder              # cross-encoder | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=20             # per retriever before rank fusion
RETRIEVAL_TOP_K=8

# --- Ingestion ---
KNOWLEDGE_BASE_DIR=knowledge_base
CHUNKING_STRATEGY=semantic          # semantic | fixed
SEMANTIC_BREAKPOINT_PERCENTILE=90   # lower = more, smaller chunks
SEMANTIC_BUFFER_SIZE=1
MAX_CHUNK_CHARS=2000
FIXED_CHUNK_SIZE_TOKENS=256
FIXED_CHUNK_OVERLAP_TOKENS=32
WEB_FETCH_TIMEOUT_S=15
WEB_MAX_BYTES=5000000

# --- Resilience ---
LLM_REQUESTS_PER_MINUTE=10
EMBEDDING_REQUESTS_PER_MINUTE=100
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_S=1.0
LLM_BACKOFF_MAX_S=30.0
LLM_TIMEOUT_S=60

# --- Cache ---
CACHE_ENABLED=true
LLM_CACHE_TTL_S=604800              # 7 days
EMBEDDING_CACHE_TTL_S=2592000       # 30 days
CACHE_KEY_VERSION=v1

# --- Infrastructure (docker compose overrides these for the api container) ---
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=mara_chunks
# CHROMA_PERSIST_PATH=./data/chroma  # embedded on-disk Chroma instead of the server (no Docker)
LOG_LEVEL=INFO
